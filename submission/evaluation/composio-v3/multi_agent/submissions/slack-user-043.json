  "report": {
    "incident_id": "slack-user-043",
    "outcome": "probable_cause",
    "hypotheses": [
      {
        "description": "Most likely for the observed cedar failures: the Slack action required a user token, but the runtime Slack configuration had no user scopes configured. Bot scopes were present, but they do not authorize user-token calls. In controlled synthetic telemetry, the same request failed with empty user scopes and passed when the needed user scope was added.",
        "supporting_evidence": [
          "ev_81d94d9c517b",
          "ev_413d5bcc63fc",
          "ev_63fcf219c68a",
          "ev_990bcd323eea",
          "ev_082370cca457",
          "ev_5101fee03862"
        ],
        "contradicting_evidence": [],
        "confidence": "high",
        "assumptions": [
          "This is scoped to the observed failed executions, not every cedar failure in the window.",
          "The controlled comparison shows the discriminating variable, but does not prove when or why production user scopes were empty."
        ]
      },
      {
        "description": "Alternative explanation: the executor may have selected the wrong Slack user connection/account, one lacking the needed user scopes, which would also produce the observed empty runtime user-scope configuration and missing_scope failure.",
        "supporting_evidence": [
          "ev_81d94d9c517b",
          "ev_413d5bcc63fc"
        ],
        "contradicting_evidence": [
          "ev_082370cca457",
          "ev_5101fee03862"
        ],
        "confidence": "medium",
        "assumptions": [
          "No canonical per-request connected-account identity is present for req-43.",
          "This explains why scopes were empty, but does not change the immediate failure mechanism."
        ]
      },
      {
        "description": "Other explanations such as a broad provider failure, workspace policy block, revoked consent, or an internal regression remain unconfirmed and are less supported by the supplied evidence.",
        "supporting_evidence": [
          "ev_81d94d9c517b"
        ],
        "contradicting_evidence": [
          "ev_082370cca457",
          "ev_5101fee03862",
          "ev_387a4b1218f7",
          "ev_413d5bcc63fc"
        ],
        "confidence": "low",
        "assumptions": [
          "Missing provider/auth detail means these alternatives are not fully eliminated.",
          "Empty partial deployment/dependency queries do not prove absence of change."
        ]
      }
    ],
    "recommended_actions": [
      "Synthetic telemetry suggests correcting Slack user-scope configuration for the intended user connection and reconnecting with the required user scope; this has not been executed.",
      "Capture canonical per-request auth/account-selection telemetry for req-43, including selected connected-account identity and granted scopes.",
      "If multiple Slack user connections exist for cedar, verify the intended account is selected before retrying.",
      "After the intended user connection has the required scope, consider replaying blocked operations only if business handling allows it.",
      "If scope/account-selection checks do not explain the issue, then request provider/auth-side evidence for workspace policy or consent state."
    ],
    "limitations": [
      "The canonical failing log does not include selected connected-account identity, granted scopes from auth service, workspace policy state, consent state, or provider response body.",
      "Cedar metrics show material impact, but the aggregate 400 failures are not all individually proven to be this exact Slack user-scope mechanism.",
      "The controlled reproduce records are synthetic telemetry and include a minor field inconsistency on the corrected record (status 200 and check_passed true while error still shows missing_scope).",
      "Cross-tenant comparison with maple weighs against a broad provider outage, but does not by itself prove cedar's exact account/configuration state."
    ]
  },
  "ranked_cause_codes": [
    "slack_user_scope_configuration",
    "wrong_connected_account",
    "unconfirmed_change"
  ],
