  "report": {
    "incident_id": "slack-plan-044",
    "outcome": "probable_cause",
    "hypotheses": [
      {
        "description": "Most likely cause for the observed cedar failures is Slack AI-search feature entitlement/eligibility not being satisfied for assistant.search.context. The failing production request logged workspace_plan=standard, is_ai_search_enabled=false, and required_plan=business_plus, and a controlled sandbox comparison succeeded when only Slack configuration was changed to Business Plus with AI search enabled. This is scoped to the observed failed execution and does not prove every reported Slack search symptom used the same connection or account.",
        "supporting_evidence": [
          "ev_a5b32714d1bd",
          "ev_58285a7ec1f7",
          "ev_d6f598e6dbcd",
          "ev_72d7f95aef85",
          "ev_47db0c677f21"
        ],
        "contradicting_evidence": [
          "ev_ca9fc6b38229",
          "ev_69e64a15f5e7"
        ],
        "confidence": "high",
        "assumptions": [
          "The cedar log fields reflect the effective Slack workspace capability seen by the failing assistant.search.context request.",
          "The controlled sandbox comparison changed only Slack configuration as recorded.",
          "Empty connection and refresh-history views do not disprove this mechanism; they leave account/scope history unverified."
        ]
      },
      {
        "description": "A weaker alternative is that assistant.search.context used a connection or account missing an AI-search-specific grant or scope, producing 403 only on that endpoint while other Slack operations remained healthy. Current evidence does not directly verify granted scopes or the exact connected account for req-44.",
        "supporting_evidence": [
          "ev_a5b32714d1bd",
          "ev_ca9fc6b38229",
          "ev_69e64a15f5e7"
        ],
        "contradicting_evidence": [
          "ev_58285a7ec1f7",
          "ev_d6f598e6dbcd"
        ],
        "confidence": "low",
        "assumptions": [
          "AI search may require grants distinct from ordinary Slack reads.",
          "The supplied empty derived views are not proof that no relevant auth or connection state changed."
        ]
      },
      {
        "description": "An internal executor-path regression or configuration issue is less likely. No tool-executor deployment was observed in-window, the only deployment was unrelated, and the discriminating controlled comparison changed outcome with Slack capability state rather than executor version. Lack of canonical provider-egress telemetry means local mapping cannot be fully excluded.",
        "supporting_evidence": [
          "ev_ca9fc6b38229",
          "ev_69e64a15f5e7"
        ],
        "contradicting_evidence": [
          "ev_a39fda00ceb5",
          "ev_1703dddeb851",
          "ev_58285a7ec1f7",
          "ev_47db0c677f21",
          "ev_d6f598e6dbcd"
        ],
        "confidence": "low",
        "assumptions": [
          "A local rejection or mapping bug could theoretically produce similar fields without an upstream Slack rejection.",
          "Absence of a recorded executor deployment reduces but does not eliminate internal-change possibilities."
        ]
      }
    ],
    "recommended_actions": [
      "Synthetic telemetry only supports a bounded diagnosis; recommended actions below are proposals and have not been executed.",
      "Check with the cedar Slack workspace admin whether the intended workspace actually has the Business Plus-or-better capability required for AI search and whether AI search is enabled for that workspace.",
      "If the workspace does not support Slack AI search, use a supported non-AI search path or obtain the required Slack plan/feature entitlement before retesting assistant.search.context.",
      "Collect canonical provider-egress telemetry for req-44 to confirm whether the 403 was emitted upstream by Slack or locally mapped by tool-executor.",
      "Collect canonical auth/account-selection data for req-44 to verify the exact connected account, token type, and any AI-search-specific scopes or grants.",
      "Align the failing cedar assistant.search.context attempts with same-window successful Slack operations on the same tenant/connection if available, to confirm the issue is isolated to AI-search capability rather than a broader Slack auth problem."
    ],
    "limitations": [
      "No canonical provider-egress trace was supplied for req-44, so upstream 403 versus locally mapped rejection is unverified.",
      "No canonical cedar ordinary-search success record was supplied; the complaint that ordinary search remained healthy is not directly verified from canonical production records here.",
      "Connections and refresh-history views were empty, but those are convenience views and do not prove absence of auth/account changes.",
      "No canonical connected-account identifier or scope/grant record was supplied for the failing request, so wrong-account and missing-grant alternatives remain possible but weaker."
    ]
  },
  "ranked_cause_codes": [
    "provider_feature_entitlement",
    "missing_grant",
    "unconfirmed_change"
  ],
