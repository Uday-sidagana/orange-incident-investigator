  "report": {
    "incident_id": "github-org-035",
    "outcome": "probable_cause",
    "hypotheses": [
      {
        "description": "Most likely cause for the observed cedar failures: GitHub organization-scoped jobs used a valid token that still had personal repository access, but org access was blocked because the GitHub organization was under a restricted OAuth policy and the app approval was still pending.",
        "supporting_evidence": [
          "ev_1469472b664b",
          "ev_e8828aa1d3ea",
          "ev_0cb724f11117",
          "ev_b53a011daaad",
          "ev_f5a6c2330485",
          "ev_1690f4f68196"
        ],
        "contradicting_evidence": [],
        "confidence": "high",
        "assumptions": [
          "Conclusions are limited to observed cedar org-scoped GitHub jobs during 2026-11-12T09:50:00Z to 2026-11-12T10:15:00Z.",
          "The synthetic sandbox comparison is discriminating support, not proof of a production-side change event.",
          "The pending approval state on the canonical failing record reflects the effective org-access state for the failed executions."
        ]
      },
      {
        "description": "Alternative explanation: a broader GitHub organization/workspace policy gate blocked org-scoped app usage, with pending approval being one manifestation of that policy rather than the only issue.",
        "supporting_evidence": [
          "ev_1469472b664b",
          "ev_e8828aa1d3ea"
        ],
        "contradicting_evidence": [
          "ev_f5a6c2330485",
          "ev_b53a011daaad"
        ],
        "confidence": "medium",
        "assumptions": [
          "This refers to GitHub org/workspace policy, not an internal session-tool policy block.",
          "The restricted policy may require explicit app approval before org resources are usable."
        ]
      },
      {
        "description": "Lower-confidence alternative: an org-specific missing grant could produce personal-resource success with org-resource failure, but available evidence points more specifically to org approval pending than to a generic permission-grant gap.",
        "supporting_evidence": [
          "ev_1469472b664b"
        ],
        "contradicting_evidence": [
          "ev_e8828aa1d3ea"
        ],
        "confidence": "low",
        "assumptions": [
          "No canonical scope inventory is present in the supplied evidence.",
          "Any such grant issue would have to be org-specific because the token appears valid and personal access is indicated."
        ]
      }
    ],
    "recommended_actions": [
      "Synthetic telemetry suggests requesting GitHub organization-owner approval for the intended OAuth app on the affected organization, then retesting the org-scoped job. This has not been executed.",
      "After approval state is corrected, replay or rerun the blocked cedar organization jobs that accumulated in queue. This has not been executed.",
      "Collect canonical per-request upstream/provider response telemetry for the failing org requests to distinguish provider-returned 403 from an internal gate reflecting the same org-approval condition. This has not been executed.",
      "Collect canonical connection/auth records around the reconnect to verify whether account identity or granted permissions changed. This has not been executed."
    ],
    "limitations": [
      "No canonical production record in the supplied evidence shows a same-connection cedar personal-repository success during the incident window; the personal-vs-org split is inferred from personal_repository_access=true on the failing record.",
      "No canonical per-request upstream trace is provided for req-35, so the evidence does not prove whether the 403 was emitted directly by GitHub or surfaced by an internal gate enforcing the same pending-approval condition.",
      "Empty refresh-history results are not proof of absence of refresh or reconnect activity.",
      "The only deployment evidence is an unrelated support-dashboard release; absence of executor/auth deployment evidence here is not exhaustive proof that no internal change occurred."
    ]
  },
