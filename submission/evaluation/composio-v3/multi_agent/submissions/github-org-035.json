          "evidence_id": "ev_1469472b664b",
          "record_id": "github-org-035:logs:0"
        }
      ]
    },
    {
      "code": "controlled_comparison",
      "statement": "In synthetic controlled reproduction, the original configuration with organization_app_approval=pending failed 403, while the otherwise same request with organization_app_approval=approved succeeded 200. This isolates org approval state as the key changed variable.",
