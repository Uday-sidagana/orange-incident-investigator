  "report": {
    "incident_id": "airtable-expiry-041",
    "outcome": "probable_cause",
    "hypotheses": [
      {
        "description": "Most likely cause for the observed failed execution: an older Airtable authentication initiation had expired before completion. The production failure shows the initiation age exceeded the allowed completion window and the flow stopped before any provider token exchange. A controlled sandbox comparison matches the old-link failure versus fresh-link success pattern.",
        "supporting_evidence": [
          "ev_547deced8d61",
          "ev_a964fad6c294",
          "ev_4978f845ca13",
          "ev_fe8e71caad06"
        ],
        "contradicting_evidence": [],
        "confidence": "high",
        "assumptions": [
          "The observed cedar failure is representative of the reported stale-link path.",
          "Canonical initiation-creation records were not supplied, so this explains the immediate failure mechanism rather than why users returned with stale links."
        ]
      },
      {
        "description": "A broad Airtable provider outage is a weaker explanation for the observed failure because the failed execution never attempted token exchange, and a same-window comparison tenant remained healthy.",
        "supporting_evidence": [
          "ev_fe8e71caad06"
        ],
        "contradicting_evidence": [
          "ev_547deced8d61",
          "ev_a964fad6c294",
          "ev_4978f845ca13"
        ],
        "confidence": "low",
        "assumptions": [
          "The maple comparison weakens a broad provider outage theory but does not prove every provider endpoint was healthy for every request."
        ]
      },
      {
        "description": "A broader internal regression or recent platform change affecting both old and fresh auth flows is not supported by the supplied observations. The evidence discriminates stale initiations from fresh ones, though canonical auth-policy/config change history was not provided.",
        "supporting_evidence": [],
        "contradicting_evidence": [
          "ev_a964fad6c294",
          "ev_4978f845ca13",
          "ev_df8ff29636a9",
          "ev_5b30e7b63b55"
        ],
        "confidence": "low",
        "assumptions": [
          "No canonical auth-service change log or TTL-policy history was supplied, so an unobserved config change elsewhere cannot be fully excluded."
        ]
      }
    ],
    "recommended_actions": [
      "Use authentication_initiation_expired_remediation for affected users: start a fresh Airtable authentication initiation and complete it within the valid window instead of retrying the expired link.",
      "Collect missing canonical auth-initiation creation, TTL, and callback-completion telemetry for impacted requests; current synthetic telemetry is enough for the immediate mechanism but not for issuance-path verification.",
      "Align telemetry windows across initiation creation, completion, expiry enforcement, and onboarding outcome so stale-link attempts can be distinguished from other auth failures.",
      "Continue lower-priority provider monitoring rather than escalating Airtable first, because the observed failed execution stops before provider exchange.",
      "These are proposed next steps only; no remediation action has been executed in this report."
    ],
    "limitations": [
      "No canonical auth-initiation creation record or policy-change record was supplied, so the report cannot verify why the initiation aged out or whether TTL/callback policy changed.",
      "The controlled reproduce evidence is supportive but not a pure age-only isolation because it also notes a configuration difference; it should be treated as corroboration, not sole proof.",
      "Observed tenant impact is bounded to supplied telemetry: cedar is materially affected while maple is healthy, but user-level counts for all returning users were not provided.",
      "Empty callback-search results do not prove absence of callback activity outside the queried fields or logging paths."
    ]
  },
  "ranked_cause_codes": [
    "authentication_initiation_expired",
