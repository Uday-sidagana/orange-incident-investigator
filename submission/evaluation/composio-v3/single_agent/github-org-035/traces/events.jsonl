5:metrics:0"}, {"evidence_id": "ev_7f728bcbf896", "record_id": "github-org-035:metrics:1"}]}, {"code": "provider_isolation", "statement": "The same provider was available for another tenant at the same time, which argues against a platform-wide GitHub outage as the primary cause of Cedar's failures.", "citations": [{"evidence_id": "ev_18bc6f424c5f", "record_id": "github-org-035:logs:1"}, {"evidence_id": "ev_7f728bcbf896", "record_id": "github-org-035:metrics:1"}]}, {"code": "policy_control", "statement": "Public GitHub guidance in the supplied knowledge base states that organizations may require owner approval of an OAuth app, matching the pending-approval condition observed for Cedar.", "citations": [{"evidence_id": "ev_56132ad6f014", "record_id": "github-org-035:knowledge:0"}]}], "action_codes": ["github_organization_approval_remediation", "replay_after_recovery", "select_intended_connected_account", "collect_missing_telemetry"]}}
