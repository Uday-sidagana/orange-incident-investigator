  "report": {
    "incident_id": "gmail-file-048",
    "outcome": "probable_cause",
    "hypotheses": [
      {
        "description": "The observed Cedar failures were caused by temporary uploaded file references expiring before delayed Gmail attachment jobs executed, causing local file lookup to return 410 and preventing any provider call.",
        "supporting_evidence": [
          "ev_7d05f5935bff",
          "ev_9eab7d67d403",
          "ev_b51bb7272c31",
          "ev_73fef531d552",
          "ev_5dc86063a888"
        ],
        "contradicting_evidence": [],
        "confidence": "high",
        "assumptions": [
          "The failing Cedar jobs used the same temporary-file-reference pattern seen in the controlled reproduction.",
          "Queue delay was sufficient for some uploaded references to expire before execution."
        ]
      },
      {
        "description": "The broader workflow may also depend on delayed-job attachment handling semantics that are incompatible with short-lived uploaded file references, making delayed execution specifically vulnerable even when immediate sends succeed.",
        "supporting_evidence": [
          "ev_b51bb7272c31",
          "ev_5dc86063a888",
          "ev_9eab7d67d403"
        ],
        "contradicting_evidence": [],
        "confidence": "medium",
        "assumptions": [
          "The queue-backed Cedar workflow reuses uploaded file references instead of refreshing or re-uploading them near execution time."
        ]
      },
      {
        "description": "A Gmail/provider outage was responsible for the failures.",
        "supporting_evidence": [
          "ev_fd8bad3f8934"
        ],
        "contradicting_evidence": [
          "ev_7d05f5935bff",
          "ev_73fef531d552",
          "ev_9eab7d67d403",
          "ev_5dc86063a888"
        ],
        "confidence": "low",
        "assumptions": [
          "This relies only on an incomplete historical analogy, not current request-path evidence."
        ]
      },
      {
        "description": "Credential or consent issues on the Gmail connection caused the failures.",
        "supporting_evidence": [],
        "contradicting_evidence": [
          "ev_7d05f5935bff",
          "ev_9eab7d67d403"
        ],
        "confidence": "low",
        "assumptions": [
          "The credential_valid field reflects the same connection used by the failing jobs."
        ]
      }
    ],
    "recommended_actions": [
      "Use a fresh file upload/reference close to execution time rather than reusing delayed temporary references.",
      "Review the delayed-job design for attachment handling and switch to a pattern supported for scheduled/delayed execution.",
      "Before retrying blocked sends, verify the attachment reference is still valid and the send reaches provider execution."
    ],
    "limitations": [
      "History results are explicitly partial and cannot prove absence of other similar incidents.",
      "No direct per-request queue-age timestamp was provided; expiration timing is inferred from the complaint, backlog, and reproduced mechanism.",
      "The reproduce tool provides precomputed sandbox observations, so similarity to production depends on the stated controlled conditions."
    ]
  },
