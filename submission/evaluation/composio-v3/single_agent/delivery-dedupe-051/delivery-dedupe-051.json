    "outcome": "probable_cause",
    "hypotheses": [
      {
        "description": "Most likely cause: the downstream webhook receiver processed retry deliveries non-idempotently. For Cedar, a single provider ingress event led to two delivery attempts with the same stable event identifier appearing on both receipts, receiver deduplication was false, and two downstream records were created. A controlled reproduction changed only delivery configuration and showed that enabling receiver deduplication reduced downstream records from 2 to 1 while provider ingress remained 1 and delivery attempts remained 2.",
        "supporting_evidence": [
          "ev_9ee12baf1f86",
          "ev_7549ab5beb31",
          "ev_823e9f64bb40",
          "ev_fc71d3df4047"
        ],
        "contradicting_evidence": [],
        "confidence": "high",
        "assumptions": [
          "The observed Cedar request is representative of the reported duplicate-record symptom during the incident window.",
          "The sandbox controlled reproduction is materially comparable to production for this retry/deduplication mechanism."
        ]
      },
      {
        "description": "Alternative explanation: duplicate records were caused by duplicate provider ingress or platform-side duplicate ingestion before delivery. This is not well supported because the observed Cedar execution recorded provider_ingress_events=1, and the controlled reproduction preserved one ingress event while still reproducing duplicates only when receiver deduplication was disabled.",
        "supporting_evidence": [],
        "contradicting_evidence": [
          "ev_9ee12baf1f86",
          "ev_7549ab5beb31"
        ],
        "confidence": "high",
        "assumptions": []
      },
      {
        "description": "Alternative explanation: an internal regression or contemporaneous deployment caused the duplication. Current evidence is weak: the only observed deployment was an unrelated support-dashboard release, and the historical case is explicitly analogy only, not current proof.",
        "supporting_evidence": [
          "ev_b3798ebb937d"
        ],
        "contradicting_evidence": [
          "ev_bcebcc5d08f8"
        ],
        "confidence": "low",
        "assumptions": [
          "No relevant unobserved trigger-worker deployment occurred outside the supplied deployment records."
        ]
      }
    ],
    "recommended_actions": [
      "webhook_receiver_not_idempotent_remediation",
      "verify_send_before_retry",
      "disable_blind_send_retries",
      "monitor_provider"
    ],
    "limitations": [
      "No canonical log in the supplied evidence identifies the exact transient webhook failure mode that triggered the retry; the diagnosis is based on the observed retry/deduplication behavior.",
      "No customer endpoint traces were provided, so receiver behavior is inferred from trigger-worker telemetry and the controlled reproduction rather than direct endpoint logs.",
      "The empty connections query does not prove absence of related configuration because derived connection views are not independent corroboration."
    ]
