  "report": {
    "incident_id": "notion-access-033",
    "outcome": "probable_cause",
    "hypotheses": [
      {
        "description": "Most likely cause: Cedar's newly added Notion page was not shared with the integration used by the connector, so reads to that page returned 404 even though the page existed and the token was still valid.",
        "supporting_evidence": [
          "ev_506504f24499",
          "ev_49ce60438821",
          "ev_41f6b24c1b8d",
          "ev_ea780c948db3"
        ],
        "contradicting_evidence": [],
        "confidence": "high",
        "assumptions": [
          "The failing Cedar requests were for the newly added page mentioned in the complaint.",
          "The controlled 'corrected' Notion configuration corresponds to granting the integration access to the intended page."
        ]
      },
      {
        "description": "Alternative considered: a broader Notion/provider outage caused the failures.",
        "supporting_evidence": [
          "ev_8830327fd77b"
        ],
        "contradicting_evidence": [
          "ev_564b202e512e",
          "ev_7249ad8b7753",
          "ev_41f6b24c1b8d",
          "ev_ea780c948db3"
        ],
        "confidence": "low",
        "assumptions": [
          "Maple is a valid same-window comparison against the same provider surface."
        ]
      },
      {
        "description": "Alternative considered: a nearby release/regression caused the missing-page behavior.",
        "supporting_evidence": [
          "ev_8830327fd77b"
        ],
        "contradicting_evidence": [
          "ev_b1329854c9c2",
          "ev_82604d12e0b9",
          "ev_41f6b24c1b8d"
        ],
        "confidence": "low",
        "assumptions": [
          "The deployment query adequately covers tool-executor changes in the incident window.",
          "No unobserved configuration rollout occurred outside the queried deployment records."
        ]
      }
    ],
    "recommended_actions": [
      "Share the intended Notion page with the existing integration/connection Cedar is using and verify that page-specific access.",
      "Have a workspace admin confirm the page is shared to the same integration that can already read Cedar's existing pages.",
      "After access is corrected, replay or retry the blocked Cedar operations that failed on this page.",
      "If the page is already shared, request workspace-admin verification of workspace/app restrictions before asking users to reconnect."
    ],
    "limitations": [
      "No canonical connection inventory identified the exact Cedar connection record; the diagnosis relies on request logs and the controlled comparison.",
      "Historical results were partial, so past analogies cannot prove the current cause.",
      "No provider-side audit trail was available; conclusions are scoped to observed platform-side evidence."
    ]
  },
  "ranked_cause_codes": [
    "notion_resource_not_shared",
    "provider_failure",
    "unconfirmed_change"
  ],
  "findings": [
    {
      "code": "mechanism_observation",
      "statement": "Cedar's failed Notion read returned 404 even though the resource existed and the token was valid; the observed missing prerequisite was integration access to that page.",
