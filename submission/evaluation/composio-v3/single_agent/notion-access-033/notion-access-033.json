        {
          "evidence_id": "ev_564b202e512e",
          "record_id": "notion-access-033:logs:1"
        }
      ]
    },
    {
      "code": "resource_role_control",
      "statement": "Public Notion toolkit guidance says access is granted to the integration on the resource, not just via generic OAuth scope, matching the observed pattern where existing pages still work while a newly added page fails until shared.",
