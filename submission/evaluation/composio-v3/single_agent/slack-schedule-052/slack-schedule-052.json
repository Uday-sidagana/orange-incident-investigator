        "assumptions": [
          "The sandbox controlled comparison is representative of the observed Cedar request path.",
          "The 'corrected' sandbox condition reflects a supported Slack configuration rather than an unrelated code-path change."
        ]
      },
      {
        "description": "Alternative considered: Slack/provider outage or general provider failure prevented file delivery.",
        "supporting_evidence": [
          "ev_43a73b31dbb1"
        ],
