  "report": {
    "incident_id": "gmail-shape-047",
    "outcome": "probable_cause",
    "hypotheses": [
      {
        "description": "Most likely cause: Cedar's Gmail attachment send requests failed validation because the attachment argument was a signed URL string instead of the required uploaded file object, so execution stopped inside tool-executor before any Google call.",
        "supporting_evidence": [
          "ev_29a42245f184",
          "ev_2167d49f6165",
          "ev_3a0f179e5b83",
          "ev_74f478a0842b",
          "ev_556b27b32bcc"
        ],
        "contradicting_evidence": [
          "ev_56498912c238",
          "ev_8a5d2d45b183"
        ],
        "confidence": "high",
        "assumptions": [
          "The affected Cedar failures are representative of the blocked attachment workflow during the incident window.",
          "The sandbox controlled reproduction is a valid mechanism check even though it uses a provider mock."
        ]
      },
      {
        "description": "Less likely alternative: a broad Gmail/Google provider outage caused the send failures.",
        "supporting_evidence": [
          "ev_dbc0769617a2"
        ],
        "contradicting_evidence": [
          "ev_2167d49f6165",
          "ev_6cfd52a18e29",
          "ev_74f478a0842b"
        ],
        "confidence": "low",
        "assumptions": [
          "Historical similarity alone does not establish the current cause."
        ]
      },
      {
        "description": "Less likely alternative: an internal regression from a contemporaneous deployment caused the failures.",
        "supporting_evidence": [
          "ev_dbc0769617a2"
        ],
        "contradicting_evidence": [
          "ev_0218c07ac029",
          "ev_4b15d5f650ae",
          "ev_74f478a0842b"
        ],
        "confidence": "low",
        "assumptions": [
          "No tool-executor deployment was observed in the incident window; absence of evidence is limited to the queried deployment telemetry."
        ]
      }
    ],
    "recommended_actions": [
      "Validate Gmail attachment payloads before execution and reject signed URL strings where uploaded file objects are required.",
      "Use the supported upload flow to obtain an uploaded file object, then pass that object in the attachment field.",
      "Replay or retry only those Cedar attachment jobs that failed with this validation error after correcting the attachment argument shape.",
      "Add request-shape telemetry or client-side checks that distinguish attachment-object errors from provider-side send failures."
    ],
    "limitations": [
      "The available Cedar canonical log sample contains one explicit failed request, not an exhaustive per-request breakdown of all 420 failures.",
      "The reproduction evidence is controlled sandbox telemetry with a provider mock; it confirms the pre-provider validation mechanism but not Google-side behavior.",
      "Empty partial log searches for Cedar plain-text success do not prove absence of successful plain-text sends during the window."
    ]
  },
