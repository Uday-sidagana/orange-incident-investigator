    "hypotheses": [
      {
        "description": "Most likely cause: the Cedar Sheets connection exists on the Platform surface, but the Connect MCP client uses a separate connection context and had no Connect MCP Sheets connection, so MCP-authenticated jobs returned 401 and prompted for authentication.",
