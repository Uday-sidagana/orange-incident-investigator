    "incident_id": "github-setup-037",
    "outcome": "probable_cause",
    "hypotheses": [
      {
        "description": "The most likely cause is an obsolete GitHub V2 setup path: the failing setup called /webhook_endpoints, but the observed V2 behavior is to create/upsert the trigger instance directly, which provisions ingress without a separate endpoint-creation step. That mismatch explains the 404 and why no trigger was created.",
        "supporting_evidence": [
          "ev_24c54419bc91",
          "ev_585556a216e4",
          "ev_3ef242d960a6"
        ],
        "contradicting_evidence": [],
        "confidence": "high",
        "assumptions": [
          "The knowledge reference reflects the intended GitHub V2 setup behavior during this incident.",
          "The controlled reproduction differed only in the documented GitHub configuration/path change relevant to setup."
        ]
      },
      {
        "description": "A generalized provider failure is less likely: one production GitHub-related comparison succeeded in the same window, and the controlled reproduction failed only with the obsolete path but succeeded with the corrected V2 path.",
        "supporting_evidence": [
          "ev_24c54419bc91"
        ],
        "contradicting_evidence": [
          "ev_24c54419bc91",
          "ev_3ef242d960a6",
          "ev_423be5077604"
        ],
        "confidence": "low",
        "assumptions": [
          "The maple comparison is a meaningful same-provider baseline for this incident window."
        ]
      },
      {
        "description": "A wrong or invalid connected account is unlikely for the observed failure because the failed setup recorded auth_valid=true, and the path-corrected controlled run succeeded without changing the authentication state.",
        "supporting_evidence": [],
        "contradicting_evidence": [
          "ev_24c54419bc91",
          "ev_3ef242d960a6"
        ],
        "confidence": "low",
        "assumptions": [
          "The auth_valid field reflects the connection actually used by the failed setup attempt."
        ]
      }
    ],
    "recommended_actions": [
      "Use the supported GitHub V2 trigger-instance create/upsert flow instead of calling /webhook_endpoints during setup.",
      "Add a guard in migrated setup logic to reject deprecated V2 endpoint-creation paths before issuing the request.",
      "Rerun blocked cedar setup jobs after correcting the setup path and verify trigger creation plus ingress provisioning on a fresh attempt.",
      "Collect any missing trigger-worker telemetry around setup-path selection so future regressions are easier to isolate quickly."
    ],
    "limitations": [
      "The connections query returned no records, so connection inventory was not independently confirmed from canonical records.",
      "One metrics query timed out before succeeding on retry, so observability was briefly incomplete.",
      "The historical incident note is analogy only and not proof of the current cause."
    ]
  },
