  "report": {
    "incident_id": "sheets-plane-038",
    "outcome": "probable_cause",
    "hypotheses": [
      {
        "description": "Most likely cause: the failed Google Sheets jobs were executed from the Connect MCP surface, but the customer's existing Sheets connection was only active on the Platform surface. The MCP surface had zero available Sheets connections, so requests were treated as unauthenticated despite an active Platform connection.",
        "supporting_evidence": [
          "ev_eec39a7b7a15",
          "ev_463205e95590",
          "ev_45fee10ce9dc",
          "ev_a8a01a6a52e9",
          "ev_7960b3accb06"
        ],
        "contradicting_evidence": [],
        "confidence": "high",
        "assumptions": [
          "The observed cedar failure path corresponds to the customer-reported MCP authentication prompt and blocked spreadsheet jobs.",
          "The controlled sandbox reproduction is representative of this production failure mechanism."
        ]
      },
      {
        "description": "Alternative considered: a general Google Sheets/provider outage caused the failures.",
        "supporting_evidence": [
          "ev_00a1de3253fb"
        ],
        "contradicting_evidence": [
          "ev_12c7e5204e37",
          "ev_7960b3accb06",
          "ev_45fee10ce9dc"
        ],
        "confidence": "low",
        "assumptions": [
          "Support for this theory comes only from incomplete historical analogy, which is not current proof."
        ]
      },
      {
        "description": "Alternative considered: an unconfirmed recent product change or regression caused MCP auth behavior to break.",
        "supporting_evidence": [
          "ev_a392479ede3a"
        ],
        "contradicting_evidence": [
          "ev_3262c332b03d",
          "ev_45fee10ce9dc"
        ],
        "confidence": "low",
        "assumptions": [
          "The only observed deployment was on an unrelated service, and no tool-executor deployment was observed in-window; this reduces but does not eliminate the possibility of an earlier or unobserved change."
        ]
      }
    ],
    "recommended_actions": [
      "connection_surface_isolation_remediation",
      "request_reproduction"
    ],
    "limitations": [
      "The history query was partial and explicitly incomplete, so historical similarity cannot prove or exclude the present cause.",
      "Empty connection and refresh-history convenience views are not independent proof of absence beyond the canonical request log evidence.",
      "Observed scope is limited to the failing cedar tenant plus one comparison tenant during the incident window."
    ]
  },
  "ranked_cause_codes": [
    "connection_surface_isolation",
    "provider_failure",
    "unconfirmed_change"
  ],
  "findings": [
