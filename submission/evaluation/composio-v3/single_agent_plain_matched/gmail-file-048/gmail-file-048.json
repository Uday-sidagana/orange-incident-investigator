{
  "incident_id": "gmail-file-048",
  "approach": "single_agent",
  "run_status": "completed",
  "report": {
    "incident_id": "gmail-file-048",
    "outcome": "probable_cause",
    "hypotheses": [
      {
        "description": "Primary: delayed Gmail attachment jobs failed because they used temporary uploaded file references that had expired before execution, so the executor could not read the file and never called Gmail.",
        "supporting_evidence": [
          "ev_027f77da1b47",
          "ev_9eab7d67d403",
          "ev_b51bb7272c31",
          "ev_a90fdc2ef1e9"
        ],
        "contradicting_evidence": [],
        "confidence": "high",
        "assumptions": [
          "The queued jobs reused previously uploaded file references rather than refreshing them just before execution.",
          "The sandbox controlled comparison is representative of the observed production failure mechanism."
        ]
      },
      {
        "description": "Secondary: queue delay/backlog likely increased the chance of reference expiry for cedar, but backlog alone is not the immediate failure mechanism.",
        "supporting_evidence": [
          "ev_a90fdc2ef1e9",
          "ev_027f77da1b47"
        ],
        "contradicting_evidence": [
          "ev_9eab7d67d403"
        ],
        "confidence": "medium",
        "assumptions": [
          "Longer wait time makes short-lived references more likely to expire before execution."
        ]
      },
      {
        "description": "Alternative considered and deprioritized: Gmail/provider outage or credential problem.",
        "supporting_evidence": [],
        "contradicting_evidence": [
          "ev_027f77da1b47",
          "ev_5497abd6f55b",
          "ev_9eab7d67d403"
        ],
        "confidence": "high",
        "assumptions": [
          "A provider outage would be more likely to affect provider calls, but the failed request never reached the provider."
        ]
      }
    ],
    "recommended_actions": [
      "temporary_file_reference_expired_remediation",
      "verify_send_before_retry",
      "replay_after_recovery",
      "collect_missing_telemetry"
    ],
    "limitations": [
      "History evidence is partial and explicitly not current proof.",
      "Connections and refresh-history queries returned no records, so they do not independently verify account/refresh state.",
      "Observed telemetry is limited to sampled records around 10:05Z, not every failed request in the incident window."
    ]
  },
  "ranked_cause_codes": [
    "temporary_file_reference_expired",
    "unconfirmed_change",
    "provider_failure"
  ],
  "findings": [
    {
      "code": "mechanism_observation",
      "statement": "The affected cedar execution failed with status 410 because the file reference was expired; file lookup also returned 410, credentials were valid, and the provider was not called.",
      "citations": [
        {
          "evidence_id": "ev_027f77da1b47",
          "record_id": "gmail-file-048:logs:0"
        }
      ]
    },
    {
      "code": "pre_provider_failure",
      "statement": "The failure happened before any Gmail provider call, which separates this incident from a downstream Gmail outage for the observed failed execution.",
      "citations": [
        {
          "evidence_id": "ev_027f77da1b47",
          "record_id": "gmail-file-048:logs:0"
        }
      ]
    },
    {
      "code": "controlled_comparison",
      "statement": "In the controlled sandbox comparison, the original condition reproduced the same expired-file 410 without a provider call, while the corrected condition used a non-expired file reference and succeeded with a provider call.",
