          "ev_595438a01016"
        ],
        "confidence": "low",
        "assumptions": [
          "Available deployment evidence is incomplete outside the observed support-dashboard release."
        ]
      }
    ],
    "recommended_actions": [
      "Apply oauth_redirect_uri_mismatch_remediation: match the custom Slack OAuth app redirect setting to the auth config callback URI, and keep the short per-connection link separate.",
      "Apply verify_custom_oauth_app to confirm the registered callback exactly matches the configured authorization redirect URI for the affected Slack app.",
      "After configuration correction, use replay_after_recovery only for any blocked business operations that require reattempting new connection flows.",
      "Monitor_provider is optional only to confirm recovery behavior; current evidence does not indicate a provider-wide outage."
    ],
    "limitations": [
