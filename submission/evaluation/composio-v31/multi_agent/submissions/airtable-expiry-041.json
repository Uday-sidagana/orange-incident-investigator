  "report": {
    "incident_id": "airtable-expiry-041",
    "outcome": "probable_cause",
    "hypotheses": [
      {
        "description": "Most likely cause for the observed failed Airtable auth execution is an expired authentication initiation. The canonical failed request was already older than its 600s completion window, returned EXPIRED/410, and never attempted provider token exchange. A controlled sandbox comparison shows the same age-related condition fails while a fresh initiation succeeds.",
        "supporting_evidence": [
          "ev_547deced8d61",
          "ev_ad0020a530a7",
          "ev_4978f845ca13",
          "ev_4a6de2586239",
          "ev_1c7dfb78223e"
        ],
        "contradicting_evidence": [],
        "confidence": "high",
        "assumptions": [
          "The observed cedar request is representative of the reported older-link failures.",
          "The controlled comparison validates initiation age as the discriminating factor for this flow, though not every possible production path is directly observed."
        ]
      },
      {
        "description": "OAuth redirect URI mismatch is a weaker alternative. Current evidence does not show a callback/config mismatch; instead the observed request is marked EXPIRED before any token exchange, and freshness alone flips the outcome in the controlled comparison.",
        "supporting_evidence": [],
        "contradicting_evidence": [
          "ev_547deced8d61",
          "ev_ad0020a530a7"
        ],
        "confidence": "low",
        "assumptions": [
          "Direct callback/configuration records are not present, so this alternative is not fully ruled out."
        ]
      },
      {
        "description": "An internal contributing change outside tool-executor remains unconfirmed. There is no observed tool-executor deployment in the incident window, but missing auth-service or session-policy change telemetry means an upstream policy or TTL change cannot be excluded as a deeper reason why expiries were prevalent.",
        "supporting_evidence": [
          "ev_6a9ad25ec4f4"
        ],
        "contradicting_evidence": [
          "ev_2c1be0296f9d",
          "ev_9f5257ec4a0a",
          "ev_ad0020a530a7"
        ],
        "confidence": "low",
        "assumptions": [
          "Any internal contributor would more likely sit in auth-service or session-policy than in a new tool-executor release.",
          "Absence of a tool-executor deployment does not prove no dependency-side change occurred."
        ]
      }
    ],
    "recommended_actions": [
      "Use a fresh Airtable authentication initiation for affected users and avoid retrying expired links; recommended actions have not been executed.",
      "Collect canonical auth-flow telemetry that links initiation creation time, callback receipt, expiry decision, and any dependency policy outcome for affected attempts.",
      "Align synthetic telemetry across auth-flow and executor stages so old-link failures and fresh-link successes can be counted by initiation age.",
      "If redirect mismatch is still suspected, verify canonical OAuth callback/config records for the affected Airtable flow.",
      "Collect auth-service and session-policy deployment/config history for the incident window, especially TTL, clock, and callback-expiry handling."
    ],
    "limitations": [
      "Synthetic telemetry is incomplete: metrics required a retry after timeout, and there are no canonical initiation-creation or callback-series records for the broader population.",
      "The maple success log is a healthy same-provider comparison, but not direct production proof of fresh auth-link success; the stronger freshness control is the sandbox comparison.",
      "History evidence is analogy only and not proof of the current cause.",
      "Observed evidence diagnoses the failed execution and localized impact, but does not fully establish why many cedar attempts were in expired state."
    ]
  },
  "ranked_cause_codes": [
    "authentication_initiation_expired",
