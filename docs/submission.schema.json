{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "record_id"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "code",
        "statement"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "supporting_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Evidence",
          "type": "array"
        },
        "contradicting_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Contradicting Evidence",
          "type": "array"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        }
      },
      "required": [
        "description",
        "supporting_evidence",
        "contradicting_evidence",
        "confidence",
        "assumptions"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "InvestigationReport": {
      "additionalProperties": false,
      "properties": {
        "incident_id": {
          "title": "Incident Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "probable_cause",
            "inconclusive"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "hypotheses": {
          "items": {
            "$ref": "#/$defs/Hypothesis"
          },
          "title": "Hypotheses",
          "type": "array"
        },
        "recommended_actions": {
          "items": {
            "type": "string"
          },
          "title": "Recommended Actions",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "incident_id",
        "outcome",
        "hypotheses",
        "recommended_actions",
        "limitations"
      ],
      "title": "InvestigationReport",
      "type": "object"
    },
    "Query": {
      "additionalProperties": false,
      "properties": {
        "tool": {
          "enum": [
            "logs",
            "metrics",
            "deployments",
            "dependencies",
            "history",
            "knowledge",
            "reproduce",
            "connections",
            "refresh_history"
          ],
          "title": "Tool",
          "type": "string"
        },
        "service": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact service field match; null includes records without a service field",
          "title": "Service"
        },
        "tenant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tenant"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inclusive timezone-aware start. Initially use null for reproduce, dependencies, history, and knowledge; records may lack timestamps",
          "title": "Start"
        },
        "end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Inclusive timezone-aware end. Initially use null for reproduce, dependencies, history, and knowledge",
          "title": "End"
        },
        "search": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Literal case-insensitive substring filter, NOT semantic search or an instruction. Start with null; use a short observed string to narrow results",
          "title": "Search"
        },
        "limit": {
          "default": 50,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        }
      },
      "required": [
        "tool"
      ],
      "title": "Query",
      "type": "object"
    },
    "ToolError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "timeout",
            "invalid_query",
            "unavailable"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "ToolError",
      "type": "object"
    },
    "ToolResult": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "query": {
          "$ref": "#/$defs/Query"
        },
        "status": {
          "enum": [
            "ok",
            "partial",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "records": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Records",
          "type": "array"
        },
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "warning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Warning"
        },
        "attempt": {
          "title": "Attempt",
          "type": "integer"
        }
      },
      "required": [
        "evidence_id",
        "query",
        "status",
        "complete",
        "attempt"
      ],
      "title": "ToolResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "incident_id": {
      "title": "Incident Id",
      "type": "string"
    },
    "approach": {
      "enum": [
        "single_agent",
        "multi_agent",
        "simulation",
        "scorer_test"
      ],
      "title": "Approach",
      "type": "string"
    },
    "run_status": {
      "default": "completed",
      "enum": [
        "completed",
        "failed"
      ],
      "title": "Run Status",
      "type": "string"
    },
    "report": {
      "$ref": "#/$defs/InvestigationReport"
    },
    "ranked_cause_codes": {
      "items": {
        "type": "string"
      },
      "title": "Ranked Cause Codes",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "action_codes": {
      "items": {
        "type": "string"
      },
      "title": "Action Codes",
      "type": "array"
    },
    "trace": {
      "items": {
        "$ref": "#/$defs/ToolResult"
      },
      "title": "Trace",
      "type": "array"
    },
    "latency_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latency Seconds"
    },
    "input_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Tokens"
    },
    "output_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Tokens"
    }
  },
  "required": [
    "incident_id",
    "approach",
    "report"
  ],
  "title": "Submission",
  "type": "object"
}
