# GPT model configuration; keep secrets in the ignored local .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REASONING_MODEL=gpt-5.4
# Optional per-role overrides: OPENAI_ORCHESTRATOR_MODEL, OPENAI_OBSERVABILITY_MODEL,
# OPENAI_DEPENDENCY_MODEL, OPENAI_CRITIC_MODEL, OPENAI_REPORTING_MODEL.

# Plain demo workspace; live integration setup is separate from local simulated mode.
PLAIN_API_KEY=
PLAIN_WEBHOOK_SECRET=

# Explicitly switch to live after verifying Plain credentials.
PLAIN_MODE=simulated

# simulation = no inference; openai = six GPT roles; codex = single-agent baseline.
INVESTIGATION_RUNTIME=simulation

# Outbound demo integrations. Enable after verifying credentials and destinations.
LINEAR_API_KEY=
LINEAR_TEAM_ID=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
LINEAR_ENABLED=false
SLACK_ENABLED=false

# Vercel only: pooled Postgres URL (e.g. Neon), private demo login.
# Queue authentication is automatic on Vercel; never put these values in browser JS.
DATABASE_URL=
DEMO_USERNAME=reviewer
DEMO_PASSWORD=
